<% image =
  if @list.photo.attached?
    if @list.photo.blob.service_name == "cloudinary"
      cl_image_path(@list.photo.key, width: 1200, height: 500, crop: :fill)
    else
      url_for(@list.photo)
    end
  else
    @list.image_url
  end %>

<div class="header-banner position-relative" style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('<%= image %>');">
  <div class="text-center">
    <h1 class="text-white"><%= @list.name %></h1>
  </div>
  <p class="badge bg-secondary rounded-pill fs-6 px-3 py-2 position-absolute top-0 end-0 m-3"><%= @list.bookmarks.count %> movies</p>
</div>

<div class="container mt-4">
  <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-success rounded-3 text-white" %>
</div>

<div class="container mt-4">
  <div class="row">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-md-4 mb-3">
        <div class="card h-100 rounded-3 shadow-sm bg-dark text-white border-secondary">
          <%= image_tag bookmark.movie.poster_url, class: "card-img-top movie-poster" %>
          <div class="card-body d-flex flex-column">
            <h3 class="fw-bold mb-3"><%= bookmark.movie.title %></h3>
            <p><i class="fa-solid fa-star text-warning"></i> <%= bookmark.movie.rating %> /10</p>
            <p class="text-white-50"><%= bookmark.movie.overview %></p>
            <p><i class="fa-solid fa-quote-left text-white-50 me-2"></i><%= bookmark.comment %></p>

            <%= link_to "Delete",
                bookmark_path(bookmark),
                class: "mt-auto btn btn-outline-danger btn-sm",
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure?"
                } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="container mb-4">
  <%= link_to "Back to All Lists", lists_path, class: "btn btn-secondary rounded-3" %>
</div>
