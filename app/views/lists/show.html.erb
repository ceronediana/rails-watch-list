<% image =
  if @list.photo.attached?
    if @list.photo.blob.service_name == "cloudinary"
      cl_image_path(@list.photo.key, width: 1200, height: 500, crop: :fill)
    else
      url_for(@list.photo)
    end
  else
    @list.image_url
  end %>

<div class="header-banner position-relative" style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('<%= image %>');">
  <div class="text-center">
    <h1 class="text-white"><%= @list.name %></h1>
  </div>
  <p class="badge bg-secondary rounded-pill fs-6 px-3 py-2 position-absolute top-0 end-0 m-3"><%= @list.bookmarks.count %> movies</p>
</div>

<div class="container mt-4">
  <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-success rounded-3 text-white" %>
</div>

<div class="container mt-4">
  <div class="row">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-md-4 mb-3">
        <div class="card h-100 rounded-3 shadow-sm bg-dark text-white border-secondary">
          <%= image_tag bookmark.movie.poster_url, class: "card-img-top movie-poster" %>
          <div class="card-body d-flex flex-column">
            <h3 class="fw-bold mb-3"><%= bookmark.movie.title %></h3>
            <p><i class="fa-solid fa-star text-warning"></i> <%= bookmark.movie.rating %> /10</p>
            <p class="text-white-50"><%= bookmark.movie.overview %></p>
            <p class="mt-auto"><i class="fa-solid fa-quote-left text-white-50 me-2"></i><%= bookmark.comment %></p>

            <%= link_to "Delete",
                bookmark_path(bookmark),
                class: "btn btn-outline-danger btn-sm",
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure?"
                } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="container mb-4">
  <%= link_to "Back to All Lists", lists_path, class: "btn btn-secondary rounded-3" %>
</div>

<div class="container mt-4">

  <%# ADD A REVIEW FORM %>
  <div class="card bg-dark text-white border-secondary rounded-3 p-4 mb-4 col-md-8">
    <h3 class="mb-3">Add a Review</h3>

    <div class="row">
      <div class="col-md-8">
        <%= simple_form_for [@list, @review] do |f| %>
          <%= f.input :comment %>

          <div class="star-rating">
            <%= f.label :rating, "Rating" %>

            <div class="stars">
              <% 5.downto(1) do |rating| %>
                <%= f.radio_button :rating, rating, id: "rating_#{rating}" %>
                <%= f.label :rating, "★", for: "rating_#{rating}" %>
              <% end %>
            </div>
          </div>

          <div class="mt-3">
            <%= f.submit class: "btn btn-success rounded-3" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%# EXISTING REVIEWS %>
  <h3 class="mb-3">Reviews (<%= @list.reviews.count %>)</h3>

  <div class="row">
    <div class="col-md-8">
      <% @list.reviews.each do |review| %>
        <div class="card rounded-3 shadow-sm bg-dark text-white border-secondary mb-3">
          <div class="card-body">
            <p class="text-warning">
              <% review.rating.to_i.times do %>
                ★
              <% end %>
            </p>
            <p><%= review.comment %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

</div>
