<div class="header-banner" style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('<%= @list.image_url %>');">
  <h1 class="text-white"><%= @list.name %></h1>
</div>

<div class="container mt-4">
  <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
</div>

<div class="container mt-4">
  <div class="row">
    <% @list.bookmarks.each do |bookmark| %>
      <div class="col-md-4 mb-3">
        <div class="card">
          <%= image_tag bookmark.movie.poster_url, class: "card-img-top movie-poster" %>
          <div class="card-body">
            <h3><%= bookmark.movie.title %></h3>
            <p><i class="fa-solid fa-star text-warning"></i> <%= bookmark.movie.rating %> /10</p>
            <p><%= bookmark.comment %></p>

            <%= link_to "Delete",
                bookmark_path(bookmark),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure?"
                } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="container mb-4">
  <%= link_to "Back to All Lists", lists_path, class: "btn btn-secondary" %>
</div>
