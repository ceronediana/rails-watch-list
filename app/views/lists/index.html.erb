<div class="header-banner">
  <h1 class="text-white">My Watch Lists</h1>
</div>

<div class="container mt-4">
  <%= link_to "Create List", new_list_path, class: "btn btn-primary my-4" %>

  <div class="row">
    <% @lists.each do |list| %>
      <div class="col-md-4 mb-3">
        <div class="list-card" style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('<%= list.image_url %>');">
          <%= link_to list.name, list_path(list) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
