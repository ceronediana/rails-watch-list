<div class="header-banner">
  <h1 class="text-white">My Watch Lists</h1>
</div>

<div class="container mt-4">
  <%= link_to "Create List", new_list_path, class: "btn btn-primary my-4" %>

  <div class="row">
    <% @lists.each do |list| %>
      <% image = if list.photo.attached?
             if list.photo.blob.service_name == "cloudinary"
               cl_image_path(list.photo.key, width: 400, height: 200, crop: :fill)
             else
               url_for(list.photo)
             end
           else
             list.image_url
           end %>
      <div class="col-md-4 mb-3">
        <div class="list-card" style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('<%= image %>');">
          <%= link_to list.name, list_path(list) %>
        </div>
      </div>
    <% end %>
  </div>
</div>
