<div class="container mt-4">
  <div class="row">
    <div class="col-md-6 mx-auto bg-dark p-4 rounded border border-secondary shadow-sm" data-bs-theme="dark">
    <h1 class="mb-4">Create a New List</h1>
      <%= simple_form_for(@list) do |f| %>
        <%= f.input :name %>
        <%= f.input :photo, as: :file %>
        <%= f.submit "Create List", class: "btn btn-success rounded-3 text-white my-4" %>
        <%= link_to "Cancel", lists_path, class: "btn btn-secondary" %>
      <% end %>
    </div>
  </div>
</div>
