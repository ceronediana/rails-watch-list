<div class="container mt-4">
  <div class="row">
    <div class="col-md-6 mx-auto bg-light p-4 rounded">
    <h1 class="mb-4">Create a New List</h1>
      <%= simple_form_for(@list) do |f| %>
        <%= f.input :name %>
        <%= f.input :image_url %>
        <%= f.submit "Create List", class: "btn btn-primary" %>
        <%= link_to "Cancel", lists_path, class: "btn btn-secondary" %>
      <% end %>
    </div>
  </div>
</div>
